@page
@model KMCEventSphereWeb.Pages.Admin.DashboardModel

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI';
        background: #f4f9f9;
    }

    h2 {
        text-align: center;
        margin-top: 30px;
    }

    /* CARD CONTAINER */
    .cards {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin: 60px 0;
        flex-wrap: wrap;
    }

    /* CARD STYLE */
    .card {
        width: 240px;
        background: white;
        padding: 20px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        transform: translateY(50px);
        opacity: 0;
        transition: 0.6s;
    }

        .card.show {
            transform: translateY(0);
            opacity: 1;
        }

        .card:hover {
            transform: scale(1.05);
        }

        .card img {
            width: 100%;
            height: 120px;
            object-fit: cover;
            border-radius: 10px;
        }

    /* BUTTON */
    .btn {
        display: inline-block;
        margin-top: 10px;
        padding: 8px 15px;
        background: #0077b6;
        color: white;
        border-radius: 6px;
        text-decoration: none;
    }

        .btn:hover {
            background: #0096c7;
        }
</style>

<h2>Admin Dashboard</h2>

<div class="cards">

    <!-- VIEW EVENTS -->
    <div class="card">
        <img src="/images/events.jpg" />
        <h3>View Events</h3>
        <p>See all created events</p>

        <a href="/Events/Index" class="btn">Go</a>
    </div>

    <!-- MANAGE USERS -->
    <div class="card">
        <img src="/images/users.jpg" />
        <h3>Manage Users</h3>
        <p>View and control users</p>

        <a href="/Admin/Users" class="btn">Go</a>
    </div>

    <!-- ADD ORGANIZER -->
    <div class="card">
        <img src="/images/add.jpg" />
        <h3>Add Organizer</h3>
        <p>Create new organizers</p>

        <a href="/Admin/AddOrganizer" class="btn">Go</a>
    </div>

    <!-- MANAGE ORGANIZERS -->
    <div class="card">
        <img src="/images/org.jpg" />
        <h3>Manage Organizers</h3>
        <p> View or Edit organizers</p>

        <a href="/Admin/Organizers" class="btn">Go</a>
    </div>

    <!-- REGISTRATIONS -->
    <div class="card">
        <img src="/images/register.jpg" />
        <h3>Registrations</h3>
        <p>View all event registrations</p>

        <a href="/Registrations" class="btn">Go</a>
    </div>

</div>

<script>
    const cards = document.querySelectorAll('.card');

    function showCards() {
        cards.forEach(card => {
            const rect = card.getBoundingClientRect();
            if (rect.top < window.innerHeight - 50) {
                card.classList.add('show');
            }
        });
    }

    window.addEventListener('scroll', showCards);
    window.addEventListener('load', showCards);
</script>