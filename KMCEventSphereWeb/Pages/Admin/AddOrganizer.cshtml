@page
@model KMCEventSphereWeb.Pages.Admin.AddOrganizerModel

<style>
    /* Background */
    body {
        background: linear-gradient(90deg, #0077b6, #0096c7);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Title */
    h2 {
        background: white;
        color: #0077b6; 
        padding: 12px;
        border-radius: 10px;
        width: fit-content;
        margin: 20px auto;
        font-weight: 700;
    }

    /* Form card */
    form {
        background: white;
        padding: 40px 30px;
        border-radius: 15px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.3);
        margin: 40px auto;
    }

    input {
    background: #fff;

    }

    /* Table layout */
    table {
        width: 100%;
        table-layout: fixed;
    }

    /* Labels */
    td:first-child {
        font-weight: 500;
        color: #555;
        padding-bottom: 10px;
        width: 40%;
    }

    td:last-child {
        width: 60%;
    }

    /* Inputs */
    input[type="text"],
    input[type="password"],
    input[type="email"] {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        margin-bottom: 15px;
        transition: 0.3s;
    }

    input:focus {
        border-color: #0077b6;
        outline: none;
    }

    /* Button */
    button {
        width: 100%;
        padding: 10px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(90deg, #0077b6, #0096c7);
        color: #fff;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        display: block;
        margin: 0 auto;
    }

        button:hover {
            background: linear-gradient(90deg, #0096c7, #00b4d8);
        }

    /* Error message */
    p[style*="color:red"] {
    background: #fff;
    padding: 10px 15px;
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    width: fit-content;
    margin: 15px auto;
    font-weight: 500;
}

    /* Success Message*/
    p[style*="color:green"] {
        background: #fff;
        padding: 10px 15px;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        width: fit-content;
        margin: 15px auto;
        font-weight: 500;
    }
</style>

<h2>Add Organizer</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p style="color:red; font-weight:bold;">
        @Model.ErrorMessage
    </p>
}

<form method="post">
    <table>
        <tr>
            <td>Username</td>
            <td>
                <input asp-for="Organizer.Username" />
                <span asp-validation-for="Organizer.Username" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td>Full Name</td>
            <td>
                <input asp-for="Organizer.FullName" />
                <span asp-validation-for="Organizer.FullName" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td>Email</td>
            <td>
                <input asp-for="Organizer.Email" />
                <span asp-validation-for="Organizer.Email" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td>Password</td>
            <td>
                <input type="password" asp-for="Organizer.Password" />
                <span asp-validation-for="Organizer.Password" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td>Phone</td>
            <td>
                <input asp-for="Organizer.Phone" />
                <span asp-validation-for="Organizer.Phone" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td>Organization Name</td>
            <td>
                <input asp-for="Organizer.OrganizationName" />
                <span asp-validation-for="Organizer.OrganizationName" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td>Address</td>
            <td>
                <input asp-for="Organizer.Address" />
                <span asp-validation-for="Organizer.Address" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td>Description</td>
            <td>
                <input asp-for="Organizer.Description" />
                <span asp-validation-for="Organizer.Description" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td></td>
            <td>
                <button type="submit">Create Organizer</button>
            </td>
        </tr>
    </table>
</form>

