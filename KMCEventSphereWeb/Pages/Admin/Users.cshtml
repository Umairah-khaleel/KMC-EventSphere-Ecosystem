@page
@model KMCEventSphereWeb.Pages.Admin.UsersModel

<style>
    /* Page background */
    body {
        background: linear-gradient(90deg, #0077b6, #0096c7);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 20px;
    }

    /* Container feel */
    h2 {
        background: white;
        color: #0077b6;
        padding: 12px;
        border-radius: 10px;
        width: fit-content;
        margin: 20px auto;
        font-weight: 700;
    }

    /* Table styling */
    table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        margin-bottom: 30px;
    }

        /* Header */
        table th {
            background: linear-gradient(90deg, #0077b6, #0096c7);
            color: #fff;
            padding: 12px;
            text-align: center;
            font-weight: 600;
        }

        /* Cells */
        table td {
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }

        /* Hover effect */
        table tr:hover {
            background-color: #f1f1f1;
            transition: 0.3s;
        }

    /* Buttons */
    button {
        padding: 6px 12px;
        border: none;
        border-radius: 6px;
        background: linear-gradient(90deg, #0077b6, #0096c7);
        color: #fff;
        cursor: pointer;
        transition: 0.3s;
    }

        button:hover {
            background: linear-gradient(90deg, #0096c7, #00b4d8);
        }

    /* Links (Edit/Delete) */
    a {
        text-decoration: none;
        color: #0077b6;
        font-weight: 500;
    }

        a:hover {
            color: #023e8a;
        }

    /* Closed label */
    span {
        font-weight: bold;
        color: #dc3545;
    }

    /* Responsive */
    @@media(max - width: 768px)

    {
        table th, table td {
            font-size: 12px;
            padding: 8px;
        }
    }

    /* Error message */
    p[style*="color:red"] {
        background: #fff;
        padding: 10px 15px;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        width: fit-content;
        margin: 15px auto;
        font-weight: 500;
    }

    /* Success Message*/
    p[style*="color:green"] {
        background: #fff;
        padding: 10px 15px;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        width: fit-content;
        margin: 15px auto;
        font-weight: 500;
    }

</style>

<h2>Manage Users</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p style="color:green; font-weight:bold;">
        @Model.Message
    </p>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p style="color:red; font-weight:bold;">
        @Model.ErrorMessage
    </p>
}

<form method="get">
    <select name="Filter">
        <option value="key">Keyword</option>
        <option value="fullName">Full Name</option>
        <option value="email">Email</option>
        <option value="role">Role</option>
        <option value="userId">User ID</option>
    </select>

    <input type="text" name="Value" />
    <button type="submit">Search</button>
</form>

<table border="1">
    <tr>
        <th>User ID</th>
        <th>Username</th>
        <th>Full Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Action</th>
    </tr>

    @foreach (var u in Model.Users)
    {
        <tr>
            <td>@u.UserID</td>
            <td>@u.Username</td>
            <td>@u.FullName</td>
            <td>@u.Email</td>
            <td>@u.Role</td>
            <td>
                @if (u.UserID == Model.CurrentUserId)
                {
                    <form method="post" asp-page-handler="Delete">
                        <input type="hidden" name="id" value="@u.UserID" />
                        <button>Delete</button> <!-- no confirm -->
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Delete">
                        <input type="hidden" name="id" value="@u.UserID" />
                        <button onclick="return confirm('Are you sure you want to delete this user?')">
                            Delete
                        </button>
                    </form>
                }
                @if (u.Role != "Organizer" && u.UserID != Model.CurrentUserId)
                {
                    <form method="post" asp-page-handler="UpdateRole" style="margin-top:5px;">
                        <input type="hidden" name="id" value="@u.UserID" />

                        <select name="Role">
                            <option value="Public" selected="@(u.Role == "Public")">Public</option>
                            <option value="Admin" selected="@(u.Role == "Admin")">Admin</option>
                        </select>

                        <button type="submit">Update</button>
                    </form>
                }
            </td>
        </tr>
    }
</table>

                    
@if (Model.Users != null && Model.Users.Count == 0 && string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p style="color:red">No results found</p>
}