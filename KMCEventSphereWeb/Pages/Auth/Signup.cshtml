@page
@model SignupModel

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="
        background: #a5d6a7;
        color: #0077b6;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 10px;
        font-weight: 500;">
        @Model.SuccessMessage
    </div>

    <script>
        setTimeout(function () {
            window.location.href = '/Auth/Login';
        }, 2000); // 2 seconds delay
    </script>
}

<style>
    /* Background */
    body {
        height: 100vh;
        background: linear-gradient(90deg, #0077b6, #0096c7);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Title */
    h2 {
        background: white;
        color: #0077b6; 
        padding: 12px;
        border-radius: 10px;
        width: fit-content;
        margin: 20px auto;
        font-weight: 700;
    }

    /* Form card */
    form {
        background: white;
        padding: 40px 30px;
        border-radius: 15px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.3);
        margin: 40px auto;
    }

    input {
    background: #fff;

    }

    /* Table layout */
    table {
        width: 100%;
    }

    /* Labels */
    td:first-child {
        font-weight: 500;
        color: #555;
        padding-bottom: 10px;
    }

    /* Inputs */
    input[type="text"],
    input[type="password"],
    input[type="email"] {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        margin-bottom: 15px;
        transition: 0.3s;
    }

    input:focus {
        border-color: #0077b6;
        outline: none;
    }

    /* Button */
    button {
        width: 100%;
        padding: 10px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(90deg, #0077b6, #0096c7);
        color: #fff;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        display: block;
        margin: 0 auto;
    }

        button:hover {
            background: linear-gradient(90deg, #0096c7, #00b4d8);
        }

    /* Error message */
    p[style*="color:red"] {
    background: #fff;
    padding: 10px 15px;
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    width: fit-content;
    margin: 15px auto;
    font-weight: 500;
}

    /* Success Message*/
    p[style*="color:green"] {
        background: #fff;
        padding: 10px 15px;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        width: fit-content;
        margin: 15px auto;
        font-weight: 500;
    }

</style>

<h2>Signup</h2>

<form method="post">
    <table>
        <tr>
            <td>Username</td>
            <td>
                <input asp-for="User.Username" />
                <span asp-validation-for="User.Username" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td>Full Name</td>
            <td>
                <input asp-for="User.FullName" />
                <span asp-validation-for="User.FullName" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td>Email</td>
            <td>
                <input asp-for="User.Email" />
                <span asp-validation-for="User.Email" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td>Password</td>
            <td>
                <input type="password" asp-for="User.Password" />
                <span asp-validation-for="User.Password" style="color:red"></span>
            </td>
        </tr>

        <tr>
            <td></td>
            <td>
                <button type="submit">Signup</button>
            </td>
        </tr>
    </table>
</form>

<p style="color:red">@Model.ErrorMessage</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}