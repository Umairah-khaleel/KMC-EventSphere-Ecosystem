@page
@model LoginModel 

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="
        background: white;
        color: #0077b6;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 10px;
        font-weight: 500;
        text-align:center;">
        @Model.SuccessMessage
    </div>

    <script>
        setTimeout(function () {
            window.location.href = '@Model.RedirectUrl';
        }, 2000);
    </script>
}

<style>
    /* Background */
    body {
        height: 100vh;
        background: linear-gradient(90deg, #0077b6, #0096c7);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Card container effect */
    form {
        background: #fff;
        padding: 40px 30px;
        border-radius: 15px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    }

    /* Title */
    h2 {
        background: white;
        color: #0077b6;
        padding: 12px;
        border-radius: 10px;
        width: fit-content;
        margin: 20px auto;
        font-weight: 700;
    }

    /* Table layout fix */
    table {
        width: 100%;
    }

    /* Labels */
    td:first-child {
        font-weight: 500;
        color: #555;
        padding-bottom: 10px;
    }

    /* Inputs */
    input[type="text"],
    input[type="password"] {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        margin-bottom: 15px;
        transition: 0.3s;
    }

    input:focus {
        border-color: #0077b6;
        outline: none;
    }

    form {
    background: #fff;
    padding: 40px 30px;
    border-radius: 15px;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    margin: 40px auto; 
    }

    /* Button */
    button {
        width: 100%;
        padding: 10px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(90deg, #0077b6, #0096c7);
        color: #fff;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
    }

        button:hover {
            background: linear-gradient(90deg, #0096c7, #00b4d8);
        }

    /* Error message */
    p[style*="color:red"] {
        background: #fff;
        padding: 10px 15px;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        width: fit-content;
        margin: 15px auto;
        font-weight: 500;
    }

        /* Success Message*/
    p[style*="color:green"] {
        background: #fff;
        padding: 10px 15px;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        width: fit-content;
        margin: 15px auto;
        font-weight: 500;
    }

</style>

<h2>Login</h2> 

<form method="post"> 
    <table>
        <tr> 
            <td>Username</td>
            <td>
                <input asp-for="Username" />
            </td>      
        </tr> 

        <tr> 
            <td>Password</td> 
            <td>
                <input type="password" asp-for="Password" />
            </td> 
        </tr> 

        <tr> 
            <td></td> 
            <td>
                <button type="submit">Login</button>
            </td> 
        </tr> 
    </table> 
</form> 

<p style="color:red">@Model.ErrorMessage</p>