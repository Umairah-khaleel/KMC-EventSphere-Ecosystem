@page
@model KMCEventSphereWeb.Pages.Events.IndexModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var role = HttpContextAccessor?.HttpContext?.Session?.GetString("Role");
}
<style>
    /* Page background */
    body {
        background: linear-gradient(90deg, #0077b6, #0096c7);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 20px;
    }

    /* Container feel */
    h2 {
        background: white;
        color: #0077b6;
        padding: 12px;
        border-radius: 10px;
        width: fit-content;
        margin: 20px auto;
        font-weight: 700;
    }

    /* Table styling */
    table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        margin-bottom: 30px;
    }

        /* Header */
        table th {
            background: linear-gradient(90deg, #0077b6, #0096c7);
            color: #fff;
            padding: 12px;
            text-align: center;
            font-weight: 600;
        }

        /* Cells */
        table td {
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }

        /* Hover effect */
        table tr:hover {
            background-color: #f1f1f1;
            transition: 0.3s;
        }

    /* Buttons */
    button {
        padding: 6px 12px;
        border: none;
        border-radius: 6px;
        background: linear-gradient(90deg, #0077b6, #0096c7);
        color: #fff;
        cursor: pointer;
        transition: 0.3s;
    }

        button:hover {
            background: linear-gradient(90deg, #0096c7, #00b4d8);
        }

    /* Links (Edit/Delete) */
    a {
        text-decoration: none;
        color: #0077b6;
        font-weight: 500;
    }

        a:hover {
            color: #023e8a;
        }

    /* Closed label */
    span {
        font-weight: bold;
        color: #dc3545;
    }

    /* Responsive */
    @@media(max - width: 768px)

    {
        table th, table td {
            font-size: 12px;
            padding: 8px;
        }
    }

    /* Error message */
    p[style*="color:red"] {
        background: #fff;
        padding: 10px 15px;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        width: fit-content;
        margin: 15px auto;
        font-weight: 500;
    }

    /* Success Message*/
    p[style*="color:green"] {
        background: #fff;
        padding: 10px 15px;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        width: fit-content;
        margin: 15px auto;
        font-weight: 500;
    }

</style>

<h2>Events</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p style="color:red">@Model.ErrorMessage</p>
}

<form method="get">
    <select name="Filter">

        @if (role == "Public")
        {
            <option value="key">Keyword</option>
            <option value="title">Title</option>
            <option value="location">Location</option>
            <option value="price">Price</option>
            <option value="eventId">Event ID</option>
            <option value="category">Category</option>
            <option value="organizerName">Organizer Name</option>
            <option value="date">Date</option>
        }

        @if (role == "Admin")
        {
            <option value="key">Keyword</option>
            <option value="organizerId">Organizer ID</option>
            <option value="organizerName">Organizer Name</option>
            <option value="eventId">Event ID</option>
            <option value="category">Category</option>
            <option value="location">Location</option>
            <option value="date">Date</option>
        }

        @if (role == "Organizer")
        {
            <option value="key">Keyword</option>
            <option value="eventId">Event ID</option>
            <option value="category">Category</option>
            <option value="location">Location</option>
            <option value="date">Date</option>
        }

    </select>

    <input type="text" name="Value" placeholder="Enter search value" />
    <button type="submit">Search</button>
</form>

<!-- ================= PUBLIC VIEW ================= -->
@if (role == "Public")
{
    <table border="1">
        <tr>
            <th>Event ID</th>
            <th>Organization Name</th>
            <th>Title</th>
            <th>Description</th>
            <th>Date</th>
            <th>Time</th>
            <th>Location</th>
            <th>Category</th>
            <th>Price</th>
            <th>Seats</th>
            <th>Register</th>
        </tr>

        @foreach (var e in Model.Events!)
        {
            <tr>
                <td>@e.EventID</td>
                <td>@(e.OrganizerName ?? "Deleted Organizer")</td>
                <td>@e.Title</td>
                <td>@e.Description</td>
                <td>@(e.Date?.ToString("yyyy-MM-dd"))</td>
                <td>@(e.Date?.ToString("HH:mm"))</td>
                <td>@e.Location</td>
                <td>@e.Category</td>
                <td>@e.Price</td>
                <td>@e.SeatsAvailable</td>
                <td>
                    @if (e.Date <= DateTime.Now)
                    {
                        <button disabled style="background:gray; cursor:not-allowed;">
                            Register
                        </button>
                        <br />
                        <span>Event Finished</span>
                    }
                    else if (e.SeatsAvailable <= 0)
                    {
                        <button disabled style="background:gray; cursor:not-allowed;">
                            Register
                        </button>
                        <br />
                        <span>Sold Out</span>
                    }
                    else
                    {
                        <a asp-page="/Registrations/Register" asp-route-eventId="@e.EventID" class="btn btn-primary">
                            Register
                        </a>
                    }
                </td>
            </tr>
        }
    </table>
    @if (Model.Events != null && Model.Events.Count == 0 && string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p style="color:red">No results found</p>
    }
}

<!-- ================= ADMIN VIEW ================= -->
@if (role == "Admin")
{
    <table border="1">
        <tr>
            <th>Event ID</th>
            <th>Organizer ID</th>
            <th>Organization Name</th>
            <th>Title</th>
            <th>Description</th>
            <th>Date</th>
            <th>Time</th>
            <th>Location</th>
            <th>Category</th>
            <th>Price</th>
            <th>Seats</th>
            <th>Registration Count</th>
        </tr>

        @foreach (var e in Model.Events!)
        {
            <tr>
                <td>@e.EventID</td>
                <td>@e.OrganizerID</td>
                <td>@(e.OrganizerName ?? "Deleted Organizer")</td>
                <td>@e.Title</td>
                <td>@e.Description</td>
                <td>@(e.Date?.ToString("yyyy-MM-dd"))</td>
                <td>@(e.Date?.ToString("HH:mm"))</td>
                <td>@e.Location</td>
                <td>@e.Category</td>
                <td>@e.Price</td>
                <td>@e.SeatsAvailable</td>
                <td>@e.RegistrationCount</td>
            </tr>
        }
    </table>

    @if (Model.Events != null && Model.Events.Count == 0 && string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p style="color:red">No results found</p>
    }
}

<!-- ================= ORGANIZER VIEW ================= -->
@if (role == "Organizer")
{
    <table border="1">
        <tr>
            <th>Event ID</th>
            <th>Title</th>
            <th>Description</th>
            <th>Date</th>
            <th>Time</th>
            <th>Location</th>
            <th>Category</th>
            <th>Price</th>
            <th>Seats</th>
            <th>Registration Count</th>
            <th>Actions</th>
        </tr>

        @foreach (var e in Model.Events!)
        {
            <tr>
                <td>@e.EventID</td>
                <td>@e.Title</td>
                <td>@e.Description</td>
                <td>@(e.Date?.ToString("yyyy-MM-dd"))</td>
                <td>@(e.Date?.ToString("HH:mm"))</td>
                <td>@e.Location</td>
                <td>@e.Category</td>
                <td>@e.Price</td>
                <td>@e.SeatsAvailable</td>
                <td>@e.RegistrationCount</td>
                <td>
                    <!-- EDIT (always visible) -->
                    <a href="/Events/Edit?id=@e.EventID">Edit</a> |

                    <!-- DELETE LOGIC -->
                    @if (e.RegistrationCount > 0)
                    {
                        <button disabled style="background:gray; cursor:not-allowed;">
                            Delete
                        </button>
                        <br />
                        <span>Has Registrations</span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Delete" style="display:inline;">
                            <input type="hidden" name="id" value="@e.EventID" />
                            <button onclick="return confirm('Are you sure you want to delete this event?')">
                                Delete
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </table>

    @if (Model.Events != null && Model.Events.Count == 0 && string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p style="color:red">No results found</p>
    }

    @if (!string.IsNullOrEmpty(TempData["Message"]?.ToString()))
    {
        <p style="color:green; font-weight:bold;">
            @TempData["Message"]
        </p>
    }
}