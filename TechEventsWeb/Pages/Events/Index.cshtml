@page
@model EventsModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var role = HttpContextAccessor?.HttpContext?.Session?.GetString("Role");
}

<h2 style="text-align:center;">Events</h2>

@if (TempData["Message"] != null)
{
    <p style="color:green; font-weight:bold;">
        @TempData["Message"]
    </p>
}

@if (TempData["Error"] != null)
{
    <p style="color:red; font-weight:bold;">
        @TempData["Error"]
    </p>
}
<style>
    /* Page background */
    body {
        background: linear-gradient(90deg, #66bb6a, #a5d6a7) !important;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 20px;
    }

    /* Container feel */
    h2 {
        background: white;
        color: #2e7d32;
        padding: 12px;
        border-radius: 10px;
        width: fit-content;
        margin: 20px auto;
        font-weight: 700;
    }

    /* Table styling */
    table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        margin-bottom: 30px;
    }

        /* Header */
        table th {
            background: linear-gradient(90deg, #66bb6a, #a5d6a7) !important;
            color: #fff;
            padding: 12px;
            text-align: center;
            font-weight: 600;
        }

        /* Cells */
        table td {
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }

        /* Hover effect */
        table tr:hover {
            background-color: #f1f1f1;
            transition: 0.3s;
        }

    /* Buttons */
    button {
        padding: 6px 12px;
        border: none;
        border-radius: 6px;
        background: linear-gradient(90deg, #66bb6a, #a5d6a7) !important;
        color: #fff;
        cursor: pointer;
        transition: 0.3s;
    }

        button:hover {
            background: linear-gradient(90deg, #66bb6a, #a5d6a7) !important;
        }

    /* Links (Edit/Delete) */
    a {
        text-decoration: none;
        color: #1b5e20;
        font-weight: 500;
    }

        a:hover {
            color: #023e8a;
        }

    /* Closed label */
    span {
        font-weight: bold;
        color: #dc3545;
    }

    /* Responsive */
    @@media(max - width: 768px) {
        table th, table td {
            font-size: 12px;
            padding: 8px;
        }
    }

    /* Error message */
    p[style*="color:red"] {
        background: #fff;
        padding: 10px 15px;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        width: fit-content;
        margin: 15px auto;
        font-weight: 500;
    }

    /* Success Message*/
    p[style*="color:green"] {
        background: #fff;
        padding: 10px 15px;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        width: fit-content;
        margin: 15px auto;
        font-weight: 500;
    }
</style>

<!-- ================= PUBLIC VIEW ================= -->
@if (role == null)
{
    <table border="1" style="width:100%;">
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Date</th>
            <th>Time</th>
            <th>Location</th>
            <th>Price</th>
            <th>Seats</th>
            <th>Action</th>
        </tr>

        @foreach (var e in Model.Events)
        {
            <tr>
                <td>@e.Title</td>
                <td>@e.Description</td>
                <td>@(e.Date?.ToString("yyyy-MM-dd"))</td>
                <td>@(e.Date?.ToString("HH:mm"))</td>
                <td>@e.Location</td>
                <td>@e.Price</td>
                <td>@e.SeatsAvailable</td>
                <td>
                    <span style="color:red; font-weight:bold;">
                        Register via KMC platform
                    </span>
                </td>
            </tr>
        }
    </table>
}

<!-- ================= ORGANIZER VIEW ================= -->
@if (role == "Organizer")
{
    <table border="1" style="width:100%;">
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Date</th>
            <th>Time</th>
            <th>Location</th>
            <th>Price</th>
            <th>Seats</th>
            <th>Registrations</th>
            <th>Actions</th>
        </tr>

        @foreach (var e in Model.Events)
        {
            <tr>
                <td>@e.Title</td>
                <td>@e.Description</td>
                <td>@(e.Date?.ToString("yyyy-MM-dd"))</td>
                <td>@(e.Date?.ToString("HH:mm"))</td>
                <td>@e.Location</td>
                <td>@e.Price</td>
                <td>@e.SeatsAvailable</td>
                <td>@e.RegistrationCount</td>
                <td>
                    <a href="/Events/Edit?id=@e.EventID">Edit</a> |
                    <form method="post" asp-page-handler="Delete" style="display:inline;">
                        <input type="hidden" name="id" value="@e.EventID" />
                        <button type="submit"
                                onclick="return confirm('Are you sure you want to delete this event?')"
                                style="background:none; border:none;  color: white; cursor:pointer;">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </table>
}