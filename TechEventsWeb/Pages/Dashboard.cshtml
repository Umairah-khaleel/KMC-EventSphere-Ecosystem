@page
@model DashboardModel

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI';
        background: #f4f9f9;
    }

    h2 {
        text-align: center;
        margin-top: 30px;
    }

    /* CARD CONTAINER */
    .cards {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin: 60px 0;
        flex-wrap: wrap;
    }

    /* CARD STYLE */
    .card {
        width: 230px;
        background: white;
        padding: 20px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        transform: translateY(50px);
        opacity: 0;
        transition: 0.6s;
    }

        .card.show {
            transform: translateY(0);
            opacity: 1;
        }

        .card:hover {
            transform: scale(1.05);
        }

        .card img {
            width: 100%;
            height: 120px;
            object-fit: cover;
            border-radius: 10px;
        }

    /* BUTTON STYLE */
    .btn {
        display: inline-block;
        margin-top: 10px;
        padding: 8px 15px;
        background: #66bb6a;
        color: white;
        border-radius: 6px;
        text-decoration: none;
    }

        .btn:hover {
            background: #a5d6a7;
        }
</style>

<h2>Organizer Dashboard</h2>

<div class="cards">

    <!-- MANAGE EVENTS -->
    <div class="card">
        <img src="/images/manage1.jpg" /> 
        <h3>Manage Events</h3>
        <p>Edit or delete your events</p>

        <a asp-page="/Events/Index" class="btn">Go</a>
    </div>

    <!-- CREATE EVENTS -->
    <div class="card">
        <img src="/images/create.jpg" />
        <h3>Create Event</h3>
        <p>Add a new tech event</p>

        <a asp-page="/Events/Create" class="btn">Go</a>
    </div>

    <!-- LOGOUT -->
    <div class="card">
        <img src="/images/logout.jpg" />
        <h3>Logout</h3>
        <p>End your session securely</p>

        <a href="/Logout" class="btn"
               onclick="return confirm('Are you sure you want to logout?')">
            Logout
        </a>
    </div>

</div>

<!-- ANIMATION -->
<script>
    const cards = document.querySelectorAll('.card');

    function showCards() {
        cards.forEach(card => {
            const rect = card.getBoundingClientRect();
            if (rect.top < window.innerHeight - 50) {
                card.classList.add('show');
            }
        });
    }

    window.addEventListener('scroll', showCards);
    window.addEventListener('load', showCards);
</script>